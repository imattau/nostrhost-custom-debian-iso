### Shared configuration (network, mirror, partitioning, account, apt, etc.)
d-i preseed/include string common.preseed

### Post-install hook: stage firstboot service
d-i preseed/late_command string \
    in-target mkdir -p /etc/nostrhost; \
    if [ -f /cdrom/units/nostrhost-firstboot.service ]; then \
        cp /cdrom/units/nostrhost-firstboot.service /target/etc/systemd/system/; \
        in-target systemctl daemon-reload; \
        in-target systemctl enable nostrhost-firstboot.service; \
    fi
